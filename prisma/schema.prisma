generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Zone {
  norte     @map("Norte")
  sur       @map("Sur")
  centro    @map("Centro")
  occidente @map("Occidente")
  chapinero @map("Chapinero")

  @@map("Zona")
}

enum OrderStatus {
  pendiente
  en_camino
  entregado
  cancelado

  @@map("EstadoPedido")
}

enum PaymentMethod {
  efectivo
  tarjeta
  app

  @@map("MetodoPago")
}

model Order {
  idPedido      String      @id @default(uuid()) @map("id_pedido")
  cliente       String
  zona          Zone
  fechaCreacion DateTime    @default(now()) @map("fecha_creacion")
  fechaEntrega  DateTime?   @map("fecha_entrega")
  estado        OrderStatus @default(pendiente)
  repartidor    String?
  metodoPago    PaymentMethod @map("metodo_pago")
  monto         Decimal     @db.Decimal(10, 2)

  @@map("pedidos")
}

enum UserRole {
  cliente
  repartidor
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}
